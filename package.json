  "scripts": {
    "start": "expo start",
    "start:dev": "APP_ENV=development EXPO_PUBLIC_APP_ENV=development expo start",
    "start:staging": "APP_ENV=staging EXPO_PUBLIC_APP_ENV=staging EXPO_PUBLIC_API_BASE_URL=https://api-stg-laweact.authsoftsolutions.org expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest --no-watchman",
    "eas:build:dev": "eas build --profile development",
    "eas:build:dev-device": "eas build --profile development-device",
    "eas:build:staging": "eas build --profile staging",
    "eas:build:production": "eas build --profile production",
    "eas:submit:staging": "eas submit --profile staging",
    "eas:submit:production": "eas submit --profile production",
    "postinstall": "patch-package",
    "prebuild:dev": "APP_ENV=development EXPO_PUBLIC_APP_ENV=development npx expo prebuild --clean",
    "prebuild:staging": "APP_ENV=staging EXPO_PUBLIC_APP_ENV=staging npx expo prebuild --clean",
    "prebuild:production": "APP_ENV=production EXPO_PUBLIC_APP_ENV=production npx expo prebuild --clean"
  },
  "jest": {
    "preset": "jest-expo",
    "resolver": "react-native-worklets/jest/resolver.js",
    "moduleNameMapper": {
      "\\.css$": "<rootDir>/test/style-mock.js",
      "^@/assets/(.*)$": "<rootDir>/assets/$1",
      "^@/(.*)$": "<rootDir>/src/$1",
      "^react-native-keyboard-controller$": "<rootDir>/node_modules/react-native-keyboard-controller/jest"
    }
  },
  "private": true,
  "packageManager": "yarn@4.9.2+sha512.1fc009bc09d13cfd0e19efa44cbfc2b9cf6ca61482725eb35bbc5e257e093ebf4130db6dfe15d604ff4b79efd8e1e8e99b25fa7d0a6197c9f9826358d4d65c3c"
