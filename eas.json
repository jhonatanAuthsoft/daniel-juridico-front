{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "APP_ENV": "development",
        "EXPO_PUBLIC_APP_ENV": "development",
        "EXPO_PUBLIC_API_BASE_URL": "https://api-stg-laweact.authsoftsolutions.org",
        "EXPO_PUBLIC_IAP_PROVIDER": "fake"
      },
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      }
    },
    "development-device": {
      "extends": "development",
      "ios": {
        "simulator": false
      }
    },
    "staging": {
      "distribution": "internal",
      "channel": "staging",
      "environment": "preview",
      "env": {
        "APP_ENV": "staging",
        "EXPO_PUBLIC_APP_ENV": "staging",
        "EXPO_PUBLIC_API_BASE_URL": "https://api-stg-laweact.authsoftsolutions.org",
        "EXPO_PUBLIC_IAP_PROVIDER": "fake"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "homolog": {
      "extends": "staging",
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_IAP_PROVIDER": "expo-iap"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "APP_ENV": "production",
        "EXPO_PUBLIC_APP_ENV": "production"
      }
    }
  },
  "submit": {
    "staging": {
      "android": {
        "track": "internal"
      }
    },
    "homolog": {
      "ios": {
        "bundleIdentifier": "com.laweact.app.staging"
      },
      "android": {
        "applicationId": "com.laweact.app.staging",
        "track": "internal"
      }
    },
    "production": {}
  }
}
