# API
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# Android emulator tip: use http://10.0.2.2:8080 instead of localhost
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080

# App environment (development | staging | production)
# Overridden automatically by EAS build profiles via eas.json `env`.
APP_ENV=development
EXPO_PUBLIC_APP_ENV=development

# Staging API (used by `eas build --profile staging` and `npm run start:staging`)
# EXPO_PUBLIC_API_BASE_URL=https://api-stg-laweact.authsoftsolutions.org
